# Frontend environment variables (Vite build-time, prefix VITE_*).
#
# В dev: оставь пустым — vite proxy /api → http://localhost:8000 (см. vite.config.ts).
# В prod (Cloudflare Pages): задай в Project Settings → Environment Variables:
#   VITE_API_BASE_URL=https://<your-backend>.up.railway.app/api

VITE_API_BASE_URL=
