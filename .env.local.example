# ============================================================
# JobRadar — локальный «деплой» через Docker + ngrok (временная мера)
# Скопируй этот файл в .env (в КОРНЕ репо) и заполни значения.
#
# Запуск:
#   1) cd frontend && npm install && npm run build   (НЕ задавать VITE_API_BASE_URL)
#   2) docker compose -f docker-compose.local.yml up --build -d
#   3) ngrok http 8000 --domain=gating-reminder-zigzagged.ngrok-free.dev
#   4) @BotFather → Mini App URL = https://gating-reminder-zigzagged.ngrok-free.dev
# ============================================================

# Окружение: dev | prod (для локального деплоя оставляем dev)
ENV=dev

# --- PostgreSQL ---
# DB_HOST НЕ задаём здесь: docker-compose.local.yml сам выставит DB_HOST=postgres
# (имя сервиса в compose-сети). Для запуска backend'а вне Docker — DB_HOST=localhost.
DB_USER=jobradar
DB_PASSWORD=change-me-strong-password
DB_NAME=jobradar

# --- Telegram ---
# Получить у @BotFather
BOT_TOKEN=0000000000:AAAA-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
INIT_DATA_TTL_SECONDS=86400
# Публичный ngrok-домен MiniApp (тот же, что регистрируем в @BotFather).
MINIAPP_URL=https://gating-reminder-zigzagged.ngrok-free.dev

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=2
LLM_FIELD_MAX_CHARS=12000

# --- Security ---
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-long-random-string
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=43200

# python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=base64-encoded-32-bytes-key-here

# --- CORS ---
# Один origin (ngrok-домен) отдаёт и SPA, и /api. Запросы идут same-origin,
# поэтому формально CORS не нужен, но на всякий случай добавляем домен в whitelist.
BACKEND_CORS_ORIGINS=https://gating-reminder-zigzagged.ngrok-free.dev

# --- Parser / hh.ru ---
# Старый публичный API hh.ru отдаёт 403 → используем headless-Chrome парсер.
PARSER_USE_CHROME=true
# Путь к Chromium ВНУТРИ контейнера (стоит в образе, см. backend/Dockerfile).
# docker-compose.local.yml уже выставляет это значение — здесь для наглядности.
CHROME_BINARY=/usr/bin/chromium
HH_WEB_BASE_URL=https://hh.ru

# Внутри-процессный шедулер. Для локального теста можно оставить выключенным
# (ручной refresh через POST /api/sources/{id}/refresh работает всегда).
PARSER_ENABLED=false
PARSER_INTERVAL_MINUTES=60
ALERTS_INTERVAL_MINUTES=60
REMINDERS_INTERVAL_MINUTES=15

# Сколько страниц выдачи и Chrome-процессов одновременно (память + риск бана!).
# Для локального деплоя держим скромно: 1 страница ≈ 1 Chrome ≈ 200-400 MB.
PARSER_MAX_PAGES=3
PARSER_CONCURRENCY=2
PARSER_PERIOD_DAYS=7

# Тайм-ауты и поведение Chrome.
# hh.ru — тяжёлая SPA; в контейнере полный рендер ~45-55s → таймаут с запасом.
PARSER_CHROME_TIMEOUT_SECONDS=75.0
PARSER_CHROME_VIRTUAL_TIME_MS=8000
PARSER_CHROME_MAX_RETRIES=2

# Джиттер между страницами (антибот), сек.
PARSER_JITTER_MIN_SECONDS=1.5
PARSER_JITTER_MAX_SECONDS=6.0

# Прокси для Chrome (--proxy-server). Пусто → IP машины (потолок при масштабе).
PARSER_PROXY_SERVER=

# Email для User-Agent (на случай fallback на старый API).
HH_USER_AGENT_CONTACT=jobradar@example.com

# --- Frontend (раздача SPA самим backend'ом) ---
# docker-compose.local.yml монтирует frontend/dist → /app/frontend_dist и
# выставляет FRONTEND_DIST_PATH=/app/frontend_dist. Для запуска вне Docker —
# укажи абсолютный путь к собранному фронту, иначе оставь пустым.
FRONTEND_DIST_PATH=
