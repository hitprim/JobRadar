# ============================================================
# JobRadar — переменные окружения
# Скопируй этот файл в .env и заполни значения
# ============================================================

# Окружение: dev | prod
ENV=dev

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=jobradar
DB_PASSWORD=change-me-strong-password
DB_NAME=jobradar

# --- Telegram ---
# Получить у @BotFather
BOT_TOKEN=0000000000:AAAA-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
# Срок жизни auth_date в initData (защита от replay). По умолчанию 24 часа.
INIT_DATA_TTL_SECONDS=86400

# --- LLM (OpenRouter) ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=2
LLM_FIELD_MAX_CHARS=12000

# --- Security ---
# Длинная случайная строка, для подписи JWT
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-long-random-string
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=43200

# KEK для envelope encryption резюме (AES-256-GCM).
# Ровно 32 байта в base64.
# Сгенерировать: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=base64-encoded-32-bytes-key-here

# --- CORS ---
# CSV-список origin'ов фронтенда. В dev можно пустым — разрешит всем (для ngrok / Vite).
# В prod ОБЯЗАТЕЛЬНО заполнить, иначе приложение не стартует.
# Пример: BACKEND_CORS_ORIGINS=https://jobradar.example.com,https://miniapp.telegram.org
BACKEND_CORS_ORIGINS=

# --- Parser / hh.ru ---
HH_API_BASE_URL=https://api.hh.ru
# Внутри-процессный шедулер парсинга. В dev/test держим выключенным.
# В prod включить: PARSER_ENABLED=true
PARSER_ENABLED=false
PARSER_INTERVAL_MINUTES=60
PARSER_MAX_PAGES=5
PARSER_PER_PAGE=50
PARSER_PERIOD_DAYS=7
PARSER_HTTP_TIMEOUT_SECONDS=10.0
# Email для User-Agent (требование hh.ru). Заменить на свой.
HH_USER_AGENT_CONTACT=jobradar@example.com
